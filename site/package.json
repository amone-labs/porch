{
  "name": "porch-site",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "astro dev",
    "build": "node video/manifest.mjs --check && astro check && astro build",
    "build:deploy": "astro check && astro build",
    "preview": "node scripts/serve.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "og": "node scripts/og.mjs",
    "appendix": "node --experimental-strip-types scripts/copy-appendix.mts",
    "capture": "vite --config video/app-capture/vite.config.ts",
    "shoot": "node video/app-capture/shoot.mjs",
    "hero": "node video/build-hero.mjs",
    "stills": "node video/stills.mjs",
    "render": "node video/render.mjs",
    "video": "pnpm shoot && pnpm obsidian && pnpm works && pnpm hero && pnpm render && pnpm stills && node video/manifest.mjs --write",
    "works": "node video/build-works.mjs",
    "obsidian": "cargo build --release -p porch-cli && node video/obsidian.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "astro": "^7.3.5",
    "posthog-js": "^1.436.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.6.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
