---
import type { Copy, Locale } from "../i18n/types";
import VideoToggle from "./VideoToggle.astro";
interface Props { t: Copy; locale: Locale }
const { t, locale } = Astro.props;
const base = `/video/hero-${locale}`;
---
<figure class="hero-video">
  <div class="screen">
    <video muted playsinline loop preload="none" poster={`${base}.jpg`} width="1600" height="900" aria-label={t.hero.video.label}>
      <source src={`${base}.webm`} type="video/webm" />
      <source src={`${base}.mp4`} type="video/mp4" />
    </video>
    <VideoToggle play={t.hero.video.play} pause={t.hero.video.pause} />
  </div>
  <figcaption class="caption">{t.hero.caption}{t.shots.uiNote && <> {t.shots.uiNote}</>}</figcaption>
</figure>
<script>
  import { autoplay } from "../video-autoplay";
  for (const fig of document.querySelectorAll<HTMLElement>(".hero-video")) autoplay(fig);
</script>
<style>
  .hero-video { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .screen { position: relative; border-radius: 16px; overflow: hidden; background: rgb(var(--canvas)); border: 1px solid rgb(var(--border)); box-shadow: var(--sh-pop); }
  video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; }
  .caption { font-size: 13px; color: rgb(var(--muted)); }
</style>
