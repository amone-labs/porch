---
import type { Copy, Locale } from "../i18n/types";
import { emph, labelClass } from "../i18n/util";
interface Props { t: Copy; locale: Locale }
const { t, locale } = Astro.props;
const s = t.setup;
---
<section id="setup" class="block" data-section="setup">
  <div class="wrap stack">
    <p class={labelClass(locale)}>{s.eyebrow}</p>
    <h2 class="h2">{s.headline}</h2>
    <ol class="steps">{s.steps.map((step) => <li set:html={emph(step)} />)}</ol>
    <div id="agent-install" class="install stack">
      <p class="muted">{s.agentLabel}</p>
      <div class="box">
        <pre><code id="agent-prompt">{s.prompt}</code></pre>
        <button type="button" class="btn btn-ghost" data-copied={s.copied} data-copy-prompt>{s.copy}</button>
      </div>
    </div>
    <p class="muted small requirements">{s.requirements}</p>
  </div>
</section>
<script>
  const button = document.querySelector<HTMLButtonElement>("#agent-install button");
  const code = document.getElementById("agent-prompt");
  button?.addEventListener("click", async () => {
    if (!code) return;
    try {
      await navigator.clipboard.writeText(code.innerText.trim());
      button.textContent = button.dataset.copied ?? button.textContent;
    } catch {
      // No clipboard (http, denied permission): select the text so ⌘C works.
      const range = document.createRange();
      range.selectNodeContents(code);
      const sel = window.getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
    }
  });
</script>
<style>
  .steps { margin: 16px 0 0; padding-left: 20px; display: flex; flex-direction: column; gap: 10px; color: rgb(var(--muted)); }
  .steps :global(strong) { color: rgb(var(--text)); font-weight: 600; }
  .install { margin-top: 24px; scroll-margin-top: 24px; }
  .box { display: flex; flex-direction: column; gap: 12px; padding: 16px; background: rgb(var(--surface)); border: 1px solid rgb(var(--border)); border-radius: var(--r-card); }
  @media (min-width: 720px) { .box { flex-direction: row; align-items: flex-start; } }
  pre { margin: 0; flex: 1; min-width: 0; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 13px; line-height: 1.6; color: rgb(var(--text)); }
  code { font-family: var(--sans); }
  .box .btn { align-self: flex-start; }
</style>
