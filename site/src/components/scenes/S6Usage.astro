---
import type { Copy, Locale } from "../../i18n/types";
interface Props { t: Copy; locale: Locale; variant: "full" | "card" }
const { t } = Astro.props;
---
<div class="s6">
  {t.scenes.limits.map((l) => (
    <div class="limit">
      <span class="lbl">{l.name}</span>
      <span class="track"><span class="limit-fill" style={`width:${l.pct}%`} /></span>
      <span class="num">{l.label}</span>
      <span class="lbl reset">{l.reset}</span>
    </div>
  ))}
</div>
<style>
  .s6 { display: flex; flex-direction: column; gap: 14px; width: 100%; }
  .limit { display: grid; grid-template-columns: 64px 1fr auto; gap: 6px 12px; align-items: center; }
  .reset { grid-column: 2 / -1; }
</style>
